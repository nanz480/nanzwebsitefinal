<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:
        radial-gradient(circle at 10% 10%,#252525 0,transparent 25%),
        radial-gradient(circle at 90% 85%,#1b1b1b 0,transparent 25%),
        #050505;
    color:#fff;
    min-height:100vh;
    padding:25px 15px;
}

.container{
    width:100%;
    max-width:560px;
    margin:auto;
}

/* CHANNEL */
.channel{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;

    width:100%;
    padding:13px 16px;
    margin-bottom:25px;

    background:#111;
    border:1px solid #333;
    border-radius:12px;

    color:#fff;
    text-decoration:none;

    font-size:12px;
    font-weight:800;
    letter-spacing:.5px;

    transition:.2s;
}

.channel span{
    font-size:12px;
}

.channel b{
    font-size:16px;
}

.channel:hover{
    background:#1d1d1d;
    border-color:#666;
    transform:translateY(-1px);
}

.channel:active{
    transform:scale(.97);
}

/* HEADER */
.header{
    text-align:center;
    margin-bottom:30px;
}

.small{
    color:#777;
    font-size:12px;
    letter-spacing:3px;
    margin-bottom:10px;
}

.logo{
    font-size:40px;
    font-weight:900;
    letter-spacing:5px;
}

.subtitle{
    color:#777;
    font-size:13px;
    margin-top:10px;
}

.line{
    height:1px;
    background:linear-gradient(
        90deg,
        transparent,
        #555,
        transparent
    );
    margin:25px 0;
}

/* SECTION */
.section-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:15px;
}

.section-title{
    font-size:18px;
    font-weight:800;
}

.section-tag{
    color:#888;
    border:1px solid #333;
    padding:5px 9px;
    border-radius:20px;
    font-size:10px;
}

/* GRID */
.grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
}

/* PRODUCT */
.card{
    position:relative;
    display:block;
    text-decoration:none;
    color:#fff;

    background:linear-gradient(
        145deg,
        #171717,
        #0b0b0b
    );

    border:1px solid #292929;
    border-radius:15px;
    padding:18px;

    overflow:hidden;
    cursor:pointer;
    user-select:none;

    transition:
        transform .15s ease,
        border-color .15s ease,
        background .15s ease;
}

.card:hover{
    transform:translateY(-2px);
    border-color:#777;

    background:linear-gradient(
        145deg,
        #202020,
        #0d0d0d
    );
}

.card:active{
    transform:scale(.96);
}

.card::before{
    content:"";
    position:absolute;

    width:80px;
    height:80px;

    right:-30px;
    top:-30px;

    background:#fff;
    opacity:.025;
    border-radius:50%;
}

.featured{
    border-color:#555;
}

/* BADGE */
.badge{
    display:inline-block;

    background:#fff;
    color:#000;

    font-size:9px;
    font-weight:bold;

    padding:4px 7px;
    border-radius:5px;

    margin-bottom:12px;
}

/* TEXT */
.duration{
    font-size:16px;
    font-weight:800;
}

.desc{
    color:#666;
    font-size:11px;
    margin-top:5px;
}

.price{
    font-size:23px;
    font-weight:900;
    margin-top:18px;
}

/* PERMANEN */
.permanent{
    grid-column:span 2;

    display:flex;
    align-items:center;
    justify-content:space-between;
}

.permanent .price{
    margin-top:0;
}

/* FOOTER */
.footer{
    text-align:center;
    color:#555;
    font-size:11px;
    line-height:1.7;
    margin-top:25px;
}

/* MOBILE */
@media(max-width:400px){

    .grid{
        grid-template-columns:1fr;
    }

    .permanent{
        grid-column:span 1;
    }

    .logo{
        font-size:34px;
    }
}
</style>
